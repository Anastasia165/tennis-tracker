# Шаблон настроек бота. Здесь только фиктивные значения.
# Настоящие значения указывай в .env рядом с bot.py.
# Если .env уже существует, добавь нужные строки вручную:
# не заменяй его этим шаблоном — иначе потеряешь настройки Telegram.

# Telegram: токен от BotFather и числовой ID твоего аккаунта.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
TELEGRAM_USER_ID=123456789

# База данных и часовой пояс (Москва = 3).
DATABASE_PATH=data/tracker.sqlite3
UTC_OFFSET_HOURS=3

# Яндекс: секретное значение API-ключа (НЕ идентификатор ключа).
# Для ручного ввода можно оставить пустым.
YANDEX_API_KEY=

# ID каталога, в котором сервисному аккаунту назначены роли.
# Это НЕ ID облака и НЕ ID сервисного аккаунта.
YANDEX_FOLDER_ID=

# Модель для разбора результатов OCR в полном импорте абонемента.
YANDEX_MODEL=yandexgpt/latest

# test_ocr.ps1 НЕ читает .env: он спросит ID каталога и ключ в терминале.
# Ввод ключа скрыт. Не вставляй секрет в команду запуска или в этот шаблон.
